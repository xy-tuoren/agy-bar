{
  "name": "agy-bar",
  "version": "0.9.4",
  "description": "Zero-dependency terminal statusline, no-TUN proxy launcher, exact TTFT & tok/s speed, 5-min cache TTL countdown, live pricing cache, automatic tab titles, 52-week token heatmap, and multi-CLI monitor for Antigravity CLI (agy).",
  "type": "module",
  "license": "MIT",
  "author": "xy-tuoren",
  "homepage": "https://github.com/xy-tuoren/agy-bar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xy-tuoren/agy-bar.git"
  },
  "bugs": {
    "url": "https://github.com/xy-tuoren/agy-bar/issues"
  },
  "keywords": [
    "antigravity",
    "agy",
    "cli",
    "statusline",
    "hud",
    "dashboard",
    "quota",
    "context-window",
    "token-usage",
    "heatmap",
    "pricing",
    "proxy",
    "gemini",
    "claude",
    "terminal"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "agy-bar": "bin/agy-bar.mjs"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "bin/",
    "src/",
    "skills/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "install:agy": "node bin/agy-bar.mjs install",
    "uninstall:agy": "node bin/agy-bar.mjs uninstall",
    "preview": "node bin/agy-bar.mjs preview",
    "preview:svg": "node scripts/generate-preview-svg.mjs && node scripts/generate-stats-svg.mjs && node scripts/generate-showcase-svgs.mjs",
    "stats": "node bin/agy-bar.mjs stats",
    "pricing": "node bin/agy-bar.mjs pricing",
    "monitor": "node bin/agy-bar.mjs monitor",
    "debug": "node bin/agy-bar.mjs debug",
    "doctor": "node bin/agy-bar.mjs doctor"
  }
}
